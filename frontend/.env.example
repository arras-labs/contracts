# ===========================================
# Real Estate DApp - Environment Variables
# ===========================================

# ------------------------------------------
# Smart Contract Configuration
# ------------------------------------------
# Indirizzo del contratto deployato
# Ottienilo dopo aver eseguito: npm run deploy:ganache o npm run deploy:polygon
VITE_CONTRACT_ADDRESS=0x5FbDB2315678afecb367f032d93F642f64180aa3

# ------------------------------------------
# Network Configuration
# ------------------------------------------

# Per Ganache (sviluppo locale)
VITE_CHAIN_ID=1337
VITE_NETWORK_NAME=Ganache Local

# Per Polygon Amoy Testnet (decommentare se usi testnet)
# VITE_CHAIN_ID=80002
# VITE_NETWORK_NAME=Polygon Amoy Testnet

# ------------------------------------------
# Dropbox Configuration
# ------------------------------------------
# Access token per upload immagini su Dropbox
# 
# Come ottenerlo:
# 1. Vai su https://www.dropbox.com/developers/apps
# 2. Crea una nuova app (Scoped access, Full Dropbox)
# 3. Vai su "Permissions" e abilita:
#    - files.metadata.write/read
#    - files.content.write/read
#    - sharing.write/read
# 4. Clicca "Submit" e poi "Generate" nella sezione "OAuth 2"
# 5. Copia il token (inizia con "sl.")
#
# ⚠️ NON committare questo file con il token reale!
# ⚠️ Usa .env per i valori reali (è già in .gitignore)
#
VITE_DROPBOX_ACCESS_TOKEN=

# ------------------------------------------
# Note di Sicurezza
# ------------------------------------------
# 
# IMPORTANTE:
# - NON condividere mai il tuo access token Dropbox
# - NON committare il file .env su Git
# - Usa questo .env.example come template
# - Copia questo file in .env e compila i valori reali
#
# Per iniziare:
# cp .env.example .env
# poi modifica .env con i tuoi valori
